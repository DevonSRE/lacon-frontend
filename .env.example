# The five keys this app reads. Copy to .env and fill in the values; .env.local
# overrides .env and is the one to use for pointing at a local backend.
#
# NEXT_PUBLIC_* is inlined into the browser bundle. Never put a key or secret
# behind that prefix.

# The address of the backend API, WITHOUT the /api/v1 suffix — the code appends
# it. NEXT_BASE_URL is read on the server; NEXT_PUBLIC_BASE_URL in the browser.
# Both normally hold the same value.
NEXT_BASE_URL=https://api.example.test
NEXT_PUBLIC_BASE_URL=https://api.example.test

# Signs the session cookie (jose). HS256, with a 32-byte random secret:
#   openssl rand -base64 32
ALGORITHM=HS256
SECRET_KEY=

# Guards the backend's public case-filing endpoints. Server-only, deliberately
# not NEXT_PUBLIC_*. Issued by the backend: ./main apikey create
CASE_API_KEY=
